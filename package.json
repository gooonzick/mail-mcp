{
  "name": "mail-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Stdio MCP server for several IMAP/SMTP mailboxes: read, search, drafts, replies, send.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "smoke": "node scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "marked": "^18.1.2",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
