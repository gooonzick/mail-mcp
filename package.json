{
  "name": "@gooonzick/mail-mcp",
  "version": "0.1.0",
  "description": "MCP server for your own IMAP/SMTP mailboxes: search, read, drafts and replies; mail is sent only from a draft you confirmed.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "email",
    "imap",
    "smtp",
    "gmail",
    "claude"
  ],
  "license": "MIT",
  "author": "George Tsamaladze",
  "homepage": "https://github.com/gooonzick/mail-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gooonzick/mail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gooonzick/mail-mcp/issues"
  },
  "type": "module",
  "bin": {
    "mail-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "accounts.example.json"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "smoke": "node scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "marked": "^18.1.2",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
